# ============================================================================
# The Farm 1893 — Environment Configuration
# Copy to .env.local and fill in. Every integration is PLUGGABLE: leave a key
# blank and the app gracefully falls back to a built-in mock so you can build,
# demo, and design without any paid accounts. Add a key to go live.
# ============================================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (database + auth) ---
# Get these from https://app.supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (insights, marketing copy, lead scoring, receptionist brain) ---
# Anthropic Claude powers the AI features. Blank = deterministic mock responses.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- AI Image Generation ("Design My Day" mood boards) ---
# When set, the visualizer generates real wedding photos in the couple's exact
# palette. Blank = curated, palette-washed imagery (still varies per selection).
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1

# --- AI Receptionist: Voice/Phone (pluggable) ---
# e.g. Twilio for the phone number + telephony. Blank = web-chat receptionist only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Payments (deposits, invoices) ---
# Stripe. Blank = payment UI runs in demo mode (no real charges).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Social media auto-posting (marketing studio) ---
# Blank = social scheduler runs in preview/mock mode.
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Email / notifications ---
RESEND_API_KEY=
NOTIFY_EMAIL=hello@thefarm1893.com

# ============================================================================
# Venue OS — operations, portals & integrations (all pluggable / demo-safe)
# ============================================================================

# --- Portals & e-signatures ---
# Signs portal magic-link + per-booking tokens. Falls back to a dev secret in
# demo; SET THIS to a long random string in production.
PORTAL_TOKEN_SECRET=
# External e-signature provider (optional). Blank = built-in native signing.
DROPBOX_SIGN_API_KEY=
DOCUSIGN_API_KEY=

# --- Email sender (invoices, receipts, reminders, magic links) ---
EMAIL_FROM="The Farm 1893 <hello@thefarm1893.com>"

# --- External calendar sync (Google / Outlook two-way; Apple via iCal) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# --- OTA / channel manager (Airbnb & VRBO). Default sync is iCal (no key). ---
HOSTAWAY_API_KEY=

# --- Review aggregation (optional; blank = curated sample set) ---
GOOGLE_PLACES_API_KEY=

# --- Cron protection (Vercel Cron: /api/reminders, /api/automations/tick) ---
CRON_SECRET=

# --- Durable rate limiting (optional external store; falls back to Supabase) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
